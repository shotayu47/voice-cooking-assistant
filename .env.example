# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Either name works: legacy anon JWT or the newer publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never referenced from client code; kept here for future
# admin scripts and migrations.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4.1.
OPENAI_MODEL=

# Optional. Phase 2 realtime voice. Defaults to gpt-realtime.
OPENAI_REALTIME_MODEL=
